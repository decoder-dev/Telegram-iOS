+
+#include "v2/RawTcpSocketFactory.h"
+
+#include <memory>
+#include <string>
+
+#include "rtc_base/async_packet_socket.h"
+#include "rtc_base/ip_address.h"
+#include "rtc_base/logging.h"
+#include "rtc_base/socket.h"
+#include "rtc_base/socket_factory.h"
+
+#include "v2/RawTcpSocket.h"
+#include "v2/Socks5ProxySocket.h"
+
+namespace tgcalls {
+namespace {
+
+[[nodiscard]] bool IsInternetFamily(int family) {
+    return family == AF_INET || family == AF_INET6;
+}
+
+[[nodiscard]] bool ValidRemoteAddress(
+        const rtc::SocketAddress &address) {
+    if (!address.port()) {
+        return false;
+    } else if (address.IsUnresolvedIP()) {
+        const auto hostname = address.hostname();
+        return !hostname.empty()
+            && hostname.size() <= 255
+            && hostname.find('\0') == std::string::npos;
+    }
+    return IsInternetFamily(address.family())
+        && !address.IsAnyIP()
+        && (address.family() != AF_INET6 || address.scope_id() == 0);
+}
+
+[[nodiscard]] bool ValidSocks5Proxy(const rtc::ProxyInfo &proxy) {
+    const auto userLength = proxy.username.size();
+    const auto passwordLength = proxy.password.GetLength();
+    return proxy.type == rtc::PROXY_SOCKS5
+        && proxy.address.port()
+        && !proxy.address.IsUnresolvedIP()
+        && IsInternetFamily(proxy.address.family())
+        && !proxy.address.IsAnyIP()
+        && userLength > 0
+        && userLength <= 255
+        && passwordLength > 0
+        && passwordLength <= 255;
+}
+
+[[nodiscard]] int BindSocket(
+        rtc::Socket *socket,
+        const rtc::SocketAddress &address) {
+    const auto result = socket->Bind(address);
+    if (result < 0 && address.IsAnyIP()) {
+        RTC_LOG(LS_WARNING)
+            << "TCP wildcard bind failed with error "
+            << socket->GetError()
+            << "; allowing Connect to bind the socket.";
+        return 0;
+    }
+    return result;
+}
+
+} // namespace
+
+rtc::AsyncPacketSocket *CreateRawTcpSocket(
+        rtc::SocketFactory *socketFactory,
+        const rtc::SocketAddress &localAddress,
+        const rtc::SocketAddress &remoteAddress,
+        const rtc::ProxyInfo &proxy) {
+    if (!socketFactory || !ValidRemoteAddress(remoteAddress)) {
+        RTC_LOG(LS_ERROR) << "Invalid raw TCP socket input.";
+        return nullptr;
+    }
+
+    const auto proxied = (proxy.type != rtc::PROXY_NONE);
+    if (proxied && !ValidSocks5Proxy(proxy)) {
+        RTC_LOG(LS_ERROR) << "Invalid or unsupported raw TCP proxy.";
+        return nullptr;
+    } else if (!proxied && !IsInternetFamily(localAddress.family())) {
+        RTC_LOG(LS_ERROR) << "Invalid direct raw TCP local address.";
+        return nullptr;
+    }
+
+    const auto socketFamily = proxied
+        ? proxy.address.family()
+        : localAddress.family();
+    auto socket = std::unique_ptr<rtc::Socket>(
+        socketFactory->CreateSocket(socketFamily, SOCK_STREAM));
+    if (!socket) {
+        return nullptr;
+    }
+
+    // A loopback sidecar cannot be reached from a socket bound to a selected
+    // external interface address. For proxied sockets, bind a wildcard address
+    // in the proxy's family and let the OS select the loopback source address.
+    const auto bindAddress = proxied
+        ? rtc::SocketAddress(rtc::GetAnyIP(socketFamily), 0)
+        : localAddress;
+    if (BindSocket(socket.get(), bindAddress) < 0) {
+        RTC_LOG(LS_ERROR)
+            << "TCP bind failed with error "
+            << socket->GetError();
+        return nullptr;
+    }
+
+    if (socket->SetOption(rtc::Socket::OPT_NODELAY, 1) != 0) {
+        RTC_LOG(LS_ERROR)
+            << "Setting TCP_NODELAY failed with error "
+            << socket->GetError();
+    }
+
+    if (proxied) {
+        socket = std::make_unique<Socks5ProxySocket>(
+            socket.release(),
+            proxy.address,
+            proxy.username,
+            proxy.password);
+    }
+    if (socket->Connect(remoteAddress) < 0) {
+        RTC_LOG(LS_ERROR)
+            << "TCP connect failed with error "
+            << socket->GetError();
+        return nullptr;
+    }
+    return new rtc::RawTcpSocket(socket.release());
+}
+
+} // namespace tgcalls
