+};
+
+[[nodiscard]] std::unique_ptr<Credentials> CopyCredentials(
+        const rtc::ProxyInfo &proxy) {
+    const auto usernameSize = proxy.username.size();
+    const auto passwordSize = proxy.password.GetLength();
+    if (usernameSize == 0
+        || usernameSize > 255
+        || passwordSize == 0
+        || passwordSize > 255) {
+        return nullptr;
+    }
+    auto result = std::make_unique<Credentials>();
+    result->username = rtc::ZeroOnFreeBuffer<char>(
+        proxy.username.data(),
+        usernameSize);
+    result->password.SetSize(passwordSize);
+    proxy.password.CopyTo(result->password.data(), false);
+    if (std::find(
+            result->username.begin(),
+            result->username.end(),
+            '\0') != result->username.end()
+        || std::find(
+            result->password.begin(),
+            result->password.end(),
+            '\0') != result->password.end()) {
+        return nullptr;
+    }
+    return result;
+}
+
+void AppendAddress(
+        std::vector<uint8_t> &result,
+        const rtc::SocketAddress &address) {
+    if (address.family() == AF_INET) {
+        const auto value = address.ipaddr().ipv4_address();
+        result.push_back(kAddressIpv4);
+        const auto bytes = reinterpret_cast<const uint8_t*>(&value);
+        result.insert(result.end(), bytes, bytes + sizeof(value));
+    } else {
+        const auto value = address.ipaddr().ipv6_address();
+        result.push_back(kAddressIpv6);
+        const auto bytes = reinterpret_cast<const uint8_t*>(&value);
+        result.insert(result.end(), bytes, bytes + sizeof(value));
+    }
+    result.push_back(uint8_t(address.port() >> 8));
+    result.push_back(uint8_t(address.port()));
+}
+
+[[nodiscard]] bool ReadAddress(
+        const uint8_t *data,
+        size_t size,
+        rtc::SocketAddress &address,
+        size_t &consumed) {
+    if (size < 1) {
+        return false;
+    }
+    const auto type = data[0];
+    const auto addressSize = (type == kAddressIpv4)
+        ? size_t(4)
+        : (type == kAddressIpv6)
+        ? size_t(16)
+        : size_t();
+    if (!addressSize || size < 1 + addressSize + 2) {
+        return false;
+    }
+    auto ip = rtc::IPAddress();
+    if (type == kAddressIpv4) {
+        auto value = in_addr();
+        std::memcpy(&value, data + 1, sizeof(value));
+        ip = rtc::IPAddress(value);
+    } else {
+        auto value = in6_addr();
+        std::memcpy(&value, data + 1, sizeof(value));
+        ip = rtc::IPAddress(value);
+    }
+    const auto portOffset = 1 + addressSize;
+    const auto port = (uint16_t(data[portOffset]) << 8)
+        | uint16_t(data[portOffset + 1]);
+    address = rtc::SocketAddress(ip, port);
+    consumed = portOffset + 2;
+    return true;
+}
+
+class Socks5UdpSocket final : public rtc::AsyncPacketSocket {
+public:
+    Socks5UdpSocket(
+        std::unique_ptr<rtc::Socket> tcp,
+        std::unique_ptr<rtc::Socket> udp,
+        const rtc::SocketAddress &proxy,
+        std::unique_ptr<Credentials> credentials,
+        std::function<void(int)> terminalFailure);
+    ~Socks5UdpSocket() override;
+
+    bool Start();
+
+    rtc::SocketAddress GetLocalAddress() const override;
+    rtc::SocketAddress GetRemoteAddress() const override;
+    int Send(
+        const void *data,
+        size_t size,
+        const rtc::PacketOptions &options) override;
+    int SendTo(
+        const void *data,
+        size_t size,
+        const rtc::SocketAddress &address,
+        const rtc::PacketOptions &options) override;
+    int Close() override;
+    State GetState() const override;
+    int GetOption(rtc::Socket::Option option, int *value) override;
+    int SetOption(rtc::Socket::Option option, int value) override;
+    int GetError() const override;
+    void SetError(int error) override;
+
+private:
+    enum class Stage {
+        Initial,
+        Greeting,
+        Authentication,
+        Association,
+        RelayConnecting,
+        Ready,
+        Closed,
+    };
+
+    struct PendingPacket {
+        std::vector<uint8_t> payload;
+        rtc::SocketAddress address;
+        rtc::PacketOptions options;
+    };
+
+    void OnTcpConnect(rtc::Socket *socket);
+    void OnTcpRead(rtc::Socket *socket);
+    void OnTcpWrite(rtc::Socket *socket);
+    void OnTcpClose(rtc::Socket *socket, int error);
+    void OnUdpConnect(rtc::Socket *socket);
+    void OnUdpRead(rtc::Socket *socket);
+    void OnUdpWrite(rtc::Socket *socket);
+    void OnUdpClose(rtc::Socket *socket, int error);
+
+    bool SendGreeting();
+    bool SendAuthentication();
+    bool SendAssociation();
+    bool QueueControl(const void *data, size_t size);
+    bool FlushControl();
+    void ProcessControlInput();
+    bool ConnectRelay(const rtc::SocketAddress &reported);
+    void RelayConnected();
+    bool FlushPackets();
+    bool SendPacket(const PendingPacket &packet);
+    void ReadRelayDatagram();
+    void EmitSent(
+        size_t payloadSize,
+        const rtc::PacketOptions &options);
+    void ClearCredentials();
+    void ClearSensitiveState();
+    bool EnterTerminal(int error);
+    void Fail(int error, const char *stage);
+
+    std::unique_ptr<rtc::Socket> _tcp;
+    std::unique_ptr<rtc::Socket> _udp;
+    rtc::SocketAddress _proxy;
+    rtc::SocketAddress _relay;
+    rtc::ZeroOnFreeBuffer<char> _username;
+    rtc::ZeroOnFreeBuffer<char> _password;
+    rtc::ZeroOnFreeBuffer<char> _controlOutput;
+    size_t _controlOffset = 0;
+    std::vector<uint8_t> _controlInput;
+    std::deque<PendingPacket> _pendingPackets;
+    size_t _pendingBytes = 0;
+    std::array<uint8_t, kReceiveBufferSize> _receiveBuffer = {};
+    Stage _stage = Stage::Initial;
+    int _error = 0;
+    std::shared_ptr<bool> _alive = std::make_shared<bool>(true);
+    std::function<void(int)> _terminalFailure;
+
+};
+
+Socks5UdpSocket::Socks5UdpSocket(
+    std::unique_ptr<rtc::Socket> tcp,
+    std::unique_ptr<rtc::Socket> udp,
+    const rtc::SocketAddress &proxy,
+    std::unique_ptr<Credentials> credentials,
+    std::function<void(int)> terminalFailure)
+: _tcp(std::move(tcp))
+, _udp(std::move(udp))
+, _proxy(proxy)
+, _username(std::move(credentials->username))
+, _password(std::move(credentials->password))
+, _terminalFailure(std::move(terminalFailure)) {
+}
+
+Socks5UdpSocket::~Socks5UdpSocket() {
+    *_alive = false;
+    EnterTerminal(0);
+    if (_tcp) {
+        _tcp->Close();
+    }
+    if (_udp) {
+        _udp->Close();
+    }
+}
+
+bool Socks5UdpSocket::Start() {
+    _tcp->SignalConnectEvent.connect(this, &Socks5UdpSocket::OnTcpConnect);
+    _tcp->SignalReadEvent.connect(this, &Socks5UdpSocket::OnTcpRead);
+    _tcp->SignalWriteEvent.connect(this, &Socks5UdpSocket::OnTcpWrite);
+    _tcp->SignalCloseEvent.connect(this, &Socks5UdpSocket::OnTcpClose);
+    _udp->SignalConnectEvent.connect(this, &Socks5UdpSocket::OnUdpConnect);
+    _udp->SignalReadEvent.connect(this, &Socks5UdpSocket::OnUdpRead);
+    _udp->SignalWriteEvent.connect(this, &Socks5UdpSocket::OnUdpWrite);
+    _udp->SignalCloseEvent.connect(this, &Socks5UdpSocket::OnUdpClose);
+    DebugStage("proxy_connecting");
+    const auto connected = _tcp->Connect(_proxy);
+    if (connected < 0 && !rtc::IsBlockingError(_tcp->GetError())) {
+        _error = _tcp->GetError();
+        Fail(_error, "proxy_connect_failed");
+        return false;
+    }
+    if (_stage == Stage::Initial
+        && _tcp->GetState() == rtc::Socket::CS_CONNECTED) {
+        OnTcpConnect(_tcp.get());
+    }
+    return _stage != Stage::Closed;
+}
+
+rtc::SocketAddress Socks5UdpSocket::GetLocalAddress() const {
+    return _udp ? _udp->GetLocalAddress() : rtc::SocketAddress();
+}
+
+rtc::SocketAddress Socks5UdpSocket::GetRemoteAddress() const {
+    return rtc::SocketAddress();
+}
+
+int Socks5UdpSocket::Send(
+        const void *,
+        size_t,
+        const rtc::PacketOptions &) {
+    SetError(SOCKET_EACCES);
+    return -1;
+}
+
+int Socks5UdpSocket::SendTo(
+        const void *data,
+        size_t size,
+        const rtc::SocketAddress &address,
+        const rtc::PacketOptions &options) {
+    if (_stage == Stage::Closed
+        || !data
+        || !size
+        || size > kMaxUdpPayload
+        || !IsValidLogicalAddress(address)
+        || _pendingPackets.size() >= kMaxQueuedPackets
+        || size > kMaxQueuedBytes - _pendingBytes) {
+        SetError((_stage == Stage::Closed) ? ENOTCONN : SOCKET_EACCES);
+        return -1;
+    }
+    auto packet = PendingPacket();
+    const auto bytes = static_cast<const uint8_t*>(data);
+    packet.payload.assign(bytes, bytes + size);
+    packet.address = address;
+    packet.options = options;
+    _pendingBytes += size;
+    _pendingPackets.push_back(std::move(packet));
+    if (_stage == Stage::Ready && !FlushPackets()) {
+        return -1;
+    }
+    return static_cast<int>(size);
+}
+
+int Socks5UdpSocket::Close() {
+    if (_stage == Stage::Closed) {
+        return 0;
+    }
+    EnterTerminal(0);
+    const auto tcpResult = _tcp ? _tcp->Close() : 0;
+    const auto udpResult = _udp ? _udp->Close() : 0;
+    return (tcpResult < 0) ? tcpResult : udpResult;
+}
+
+rtc::AsyncPacketSocket::State Socks5UdpSocket::GetState() const {
+    if (_stage == Stage::Closed) {
+        return STATE_CLOSED;
+    } else if (_stage == Stage::Ready) {
+        return STATE_BOUND;
+    }
+    return STATE_BINDING;
+}
+
+int Socks5UdpSocket::GetOption(rtc::Socket::Option option, int *value) {
+    return _udp->GetOption(option, value);
+}
+
+int Socks5UdpSocket::SetOption(rtc::Socket::Option option, int value) {
+    return _udp->SetOption(option, value);
+}
+
+int Socks5UdpSocket::GetError() const {
+    return _error;
+}
+
+void Socks5UdpSocket::SetError(int error) {
+    _error = error;
+    if (_udp) {
+        _udp->SetError(error);
+    }
+}
+
+void Socks5UdpSocket::OnTcpConnect(rtc::Socket *socket) {
+    if (socket != _tcp.get() || _stage != Stage::Initial) {
+        Fail(SOCKET_EACCES, "unexpected_tcp_connect");
+        return;
+    }
+    DebugStage("proxy_connected");
+    SendGreeting();
+}
+
+void Socks5UdpSocket::OnTcpRead(rtc::Socket *socket) {
+    if (socket != _tcp.get()
+        || _stage == Stage::Closed
+        || _stage == Stage::Ready
+        || _stage == Stage::RelayConnecting) {
+        Fail(SOCKET_EACCES, "unexpected_control_read");
+        return;
+    }
+    auto buffer = std::array<uint8_t, kMaxHandshakeInput>();
+    while (_stage != Stage::Closed) {
+        auto timestamp = int64_t();
+        const auto received = _tcp->Recv(
+            buffer.data(),
+            buffer.size(),
+            &timestamp);
+        if (received > 0) {
+            if (_controlInput.size() + size_t(received)
+                    > kMaxHandshakeInput) {
+                Fail(SOCKET_EACCES, "control_reply_oversize");
+                return;
+            }
+            _controlInput.insert(
+                _controlInput.end(),
+                buffer.begin(),
+                buffer.begin() + received);
+        } else if (received == 0) {
+            Fail(ECONNRESET, "control_eof");
+            return;
+        } else if (rtc::IsBlockingError(_tcp->GetError())) {
+            break;
+        } else {
+            Fail(_tcp->GetError(), "control_read_failed");
+            return;
+        }
+    }
+    ProcessControlInput();
+}
+
+void Socks5UdpSocket::OnTcpWrite(rtc::Socket *socket) {
+    if (socket != _tcp.get() || _stage == Stage::Closed) {
+        return;
+    }
+    FlushControl();
+}
+
+void Socks5UdpSocket::OnTcpClose(rtc::Socket *socket, int error) {
+    if (socket == _tcp.get() && _stage != Stage::Closed) {
+        Fail(error ? error : ECONNRESET, "control_closed");
+    }
+}
+
+void Socks5UdpSocket::OnUdpConnect(rtc::Socket *socket) {
+    if (socket != _udp.get() || _stage != Stage::RelayConnecting) {
+        Fail(SOCKET_EACCES, "unexpected_relay_connect");
+        return;
+    }
+    RelayConnected();
+}
+
+void Socks5UdpSocket::OnUdpRead(rtc::Socket *socket) {
+    if (socket != _udp.get() || _stage != Stage::Ready) {
+        Fail(SOCKET_EACCES, "unexpected_relay_read");
+        return;
+    }
+    ReadRelayDatagram();
+}
+
+void Socks5UdpSocket::OnUdpWrite(rtc::Socket *socket) {
+    if (socket != _udp.get() || _stage != Stage::Ready) {
+        return;
+    }
+    if (FlushPackets()
+        && _stage == Stage::Ready
+        && _pendingPackets.empty()) {
+        SignalReadyToSend.emit(this);
+    }
+}
+
+void Socks5UdpSocket::OnUdpClose(rtc::Socket *socket, int error) {
+    if (socket == _udp.get() && _stage != Stage::Closed) {
+        Fail(error ? error : ECONNRESET, "relay_closed");
+    }
+}
+
+bool Socks5UdpSocket::SendGreeting() {
+    const auto request = std::array<uint8_t, 3>{
+        kSocksVersion,
+        1,
+        kPasswordAuthentication,
+    };
+    _stage = Stage::Greeting;
+    DebugStage("greeting_sent");
+    return QueueControl(request.data(), request.size());
+}
+
+bool Socks5UdpSocket::SendAuthentication() {
+    auto request = rtc::ZeroOnFreeBuffer<char>();
+    request.SetSize(3 + _username.size() + _password.size());
+    auto offset = size_t();
+    request[offset++] = char(kAuthenticationVersion);
+    request[offset++] = char(_username.size());
+    std::memcpy(request.data() + offset, _username.data(), _username.size());
+    offset += _username.size();
+    request[offset++] = char(_password.size());
+    std::memcpy(request.data() + offset, _password.data(), _password.size());
+    _stage = Stage::Authentication;
+    DebugStage("authentication_sent");
+    return QueueControl(request.data(), request.size());
+}
+
+bool Socks5UdpSocket::SendAssociation() {
+    auto request = std::vector<uint8_t>{
+        kSocksVersion,
+        kUdpAssociateCommand,
+        0,
+    };
+    const auto wildcard = rtc::SocketAddress(
+        rtc::GetAnyIP(_proxy.family()),
+        0);
+    AppendAddress(request, wildcard);
+    _stage = Stage::Association;
+    DebugStage("association_sent");
+    return QueueControl(request.data(), request.size());
+}
+
+bool Socks5UdpSocket::QueueControl(const void *data, size_t size) {
+    if (_stage == Stage::Closed
+        || !data
+        || !size
+        || !_controlOutput.empty()
+        || _controlOffset != 0) {
+        Fail(SOCKET_EACCES, "control_queue_failed");
+        return false;
+    }
+    _controlOutput = rtc::ZeroOnFreeBuffer<char>(
+        static_cast<const char*>(data),
+        size);
+    return FlushControl();
+}
+
+bool Socks5UdpSocket::FlushControl() {
+    while (_stage != Stage::Closed
+        && _controlOffset < _controlOutput.size()) {
+        const auto sent = _tcp->Send(
+            _controlOutput.data() + _controlOffset,
+            _controlOutput.size() - _controlOffset);
+        if (sent > 0) {
+            _controlOffset += size_t(sent);
+        } else if (sent < 0 && rtc::IsBlockingError(_tcp->GetError())) {
+            return true;
+        } else {
+            Fail(
+                (sent < 0) ? _tcp->GetError() : SOCKET_EACCES,
+                "control_write_failed");
+            return false;
+        }
+    }
+    if (_stage == Stage::Closed) {
+        return false;
+    }
+    _controlOutput.Clear();
+    _controlOffset = 0;
+    if (_stage == Stage::Authentication) {
+        ClearCredentials();
+    }
+    return true;
+}
+
+void Socks5UdpSocket::ProcessControlInput() {
+    if (_stage == Stage::Closed || !_controlOutput.empty()) {
+        if (_stage != Stage::Closed && !_controlInput.empty()) {
+            Fail(SOCKET_EACCES, "premature_control_reply");
+        }
+        return;
+    }
+    if (_stage == Stage::Greeting) {
+        if (_controlInput.size() < 2) {
+            return;
+        } else if (_controlInput.size() != 2
+            || _controlInput[0] != kSocksVersion
+            || _controlInput[1] != kPasswordAuthentication) {
+            Fail(SOCKET_EACCES, "greeting_rejected");
+            return;
+        }
+        _controlInput.clear();
+        SendAuthentication();
+    } else if (_stage == Stage::Authentication) {
+        if (_controlInput.size() < 2) {
+            return;
+        } else if (_controlInput.size() != 2
+            || _controlInput[0] != kAuthenticationVersion
+            || _controlInput[1] != 0) {
+            Fail(SOCKET_EACCES, "authentication_rejected");
+            return;
+        }
+        _controlInput.clear();
+        DebugStage("authentication_ok");
+        SendAssociation();
+    } else if (_stage == Stage::Association) {
+        if (_controlInput.size() < 4) {
+            return;
+        } else if (_controlInput[0] != kSocksVersion
+            || _controlInput[1] != 0
+            || _controlInput[2] != 0
+            || (_controlInput[3] != kAddressIpv4
+                && _controlInput[3] != kAddressIpv6)) {
+            Fail(SOCKET_EACCES, "association_rejected");
+            return;
+        }
+        const auto expected = (_controlInput[3] == kAddressIpv4)
+            ? size_t(10)
+            : size_t(22);
+        if (_controlInput.size() < expected) {
+            return;
+        } else if (_controlInput.size() != expected) {
+            Fail(SOCKET_EACCES, "association_reply_ambiguous");
+            return;
+        }
+        auto relay = rtc::SocketAddress();
+        auto consumed = size_t();
+        if (!ReadAddress(
+                _controlInput.data() + 3,
+                _controlInput.size() - 3,
+                relay,
+                consumed)
+            || consumed + 3 != _controlInput.size()) {
+            Fail(SOCKET_EACCES, "association_address_invalid");
+            return;
+        }
+        _controlInput.clear();
+        ConnectRelay(relay);
+    } else if (!_controlInput.empty()) {
+        Fail(SOCKET_EACCES, "unexpected_control_data");
+    }
+}
+
+bool Socks5UdpSocket::ConnectRelay(
+        const rtc::SocketAddress &reported) {
+    if (!reported.port()
+        || reported.family() != _proxy.family()
+        || (reported.family() == AF_INET6 && reported.scope_id() != 0)) {
+        Fail(SOCKET_EACCES, "relay_address_rejected");
+        return false;
+    }
+    auto relay = reported;
+    if (relay.IsAnyIP()) {
+        relay.SetIP(_proxy.ipaddr());
+    }
+    if (!relay.IsLoopbackIP()) {
+        Fail(SOCKET_EACCES, "relay_not_loopback");
+        return false;
+    }
+    _relay = relay;
+    _stage = Stage::RelayConnecting;
+    DebugStage("relay_connecting");
+    const auto alive = _alive;
+    const auto connected = _udp->Connect(_relay);
+    if (!*alive) {
+        return false;
+    }
+    if (connected < 0 && !rtc::IsBlockingError(_udp->GetError())) {
+        Fail(_udp->GetError(), "relay_connect_failed");
+        return false;
+    }
+    if (_stage == Stage::RelayConnecting
+        && _udp->GetState() == rtc::Socket::CS_CONNECTED) {
+        RelayConnected();
+    }
+    if (!*alive) {
+        return false;
+    }
+    return _stage != Stage::Closed;
+}
+
+void Socks5UdpSocket::RelayConnected() {
+    if (_stage != Stage::RelayConnecting
+        || _udp->GetRemoteAddress() != _relay) {
+        Fail(SOCKET_EACCES, "relay_connection_mismatch");
+        return;
+    }
+    _stage = Stage::Ready;
+    DebugStage("ready");
+    const auto local = GetLocalAddress();
+    const auto alive = _alive;
+    SignalAddressReady.emit(this, local);
+    if (!*alive) {
+        return;
+    }
+    if (!FlushPackets() || _stage != Stage::Ready) {
+        return;
+    }
+    SignalReadyToSend.emit(this);
+}
+
+bool Socks5UdpSocket::FlushPackets() {
+    while (_stage == Stage::Ready && !_pendingPackets.empty()) {
+        auto &packet = _pendingPackets.front();
+        const auto alive = _alive;
+        const auto sent = SendPacket(packet);
+        if (!*alive) {
+            return false;
+        } else if (!sent) {
+            return _stage != Stage::Closed;
+        }
+        const auto payloadSize = packet.payload.size();
+        const auto options = packet.options;
+        _pendingBytes -= payloadSize;
+        std::fill(packet.payload.begin(), packet.payload.end(), uint8_t());
+        _pendingPackets.pop_front();
+        EmitSent(payloadSize, options);
+        if (!*alive) {
+            return false;
+        }
+    }
+    return _stage != Stage::Closed;
+}
+
+bool Socks5UdpSocket::SendPacket(const PendingPacket &packet) {
+    auto framed = std::vector<uint8_t>{ 0, 0, 0 };
+    framed.reserve(packet.payload.size() + 22);
+    AppendAddress(framed, packet.address);
+    framed.insert(
+        framed.end(),
+        packet.payload.begin(),
+        packet.payload.end());
+    const auto sent = _udp->Send(framed.data(), framed.size());
+    if (sent == int(framed.size())) {
+        return true;
+    } else if (sent < 0 && rtc::IsBlockingError(_udp->GetError())) {
+        return false;
+    }
+    Fail(
+        (sent < 0) ? _udp->GetError() : SOCKET_EACCES,
+        "relay_write_failed");
+    return false;
+}
+
+void Socks5UdpSocket::ReadRelayDatagram() {
+    while (_stage == Stage::Ready) {
+        auto timestamp = int64_t();
+        const auto received = _udp->Recv(
+            _receiveBuffer.data(),
+            _receiveBuffer.size(),
+            &timestamp);
+        if (received < 0 && rtc::IsBlockingError(_udp->GetError())) {
+            return;
+        } else if (received <= 0) {
+            Fail(
+                (received < 0) ? _udp->GetError() : ECONNRESET,
+                "relay_read_failed");
+            return;
+        }
+        const auto size = size_t(received);
+        if (size < 4
+            || _receiveBuffer[0] != 0
+            || _receiveBuffer[1] != 0
+            || _receiveBuffer[2] != 0) {
+            Fail(SOCKET_EACCES, "relay_frame_rejected");
+            return;
+        }
+        auto source = rtc::SocketAddress();
+        auto headerSize = size_t();
+        if (!ReadAddress(
+                _receiveBuffer.data() + 3,
+                size - 3,
+                source,
+                headerSize)
+            || !IsValidLogicalAddress(source)
+            || 3 + headerSize > size) {
+            Fail(SOCKET_EACCES, "relay_source_rejected");
+            return;
+        }
+        const auto payloadOffset = 3 + headerSize;
+        NotifyPacketReceived(rtc::ReceivedPacket::CreateFromLegacy(
+            _receiveBuffer.data() + payloadOffset,
+            size - payloadOffset,
+            rtc::TimeMicros(),
+            source));
+        return;
+    }
+}
+
+void Socks5UdpSocket::EmitSent(
+        size_t payloadSize,
+        const rtc::PacketOptions &options) {
+    auto sent = rtc::SentPacket(
+        options.packet_id,
+        rtc::TimeMillis(),
+        options.info_signaled_after_sent);
+    rtc::CopySocketInformationToPacketInfo(
+        payloadSize,
+        *this,
+        true,
+        &sent.info);
+    SignalSentPacket.emit(this, sent);
+}
+
+void Socks5UdpSocket::ClearCredentials() {
+    _username.Clear();
+    _password.Clear();
+}
+
+void Socks5UdpSocket::ClearSensitiveState() {
+    ClearCredentials();
+    _controlOutput.Clear();
+    _controlOffset = 0;
+    std::fill(_controlInput.begin(), _controlInput.end(), uint8_t());
+    _controlInput.clear();
+    for (auto &packet : _pendingPackets) {
+        std::fill(packet.payload.begin(), packet.payload.end(), uint8_t());
+    }
+    _pendingPackets.clear();
+    _pendingBytes = 0;
+    std::fill(_receiveBuffer.begin(), _receiveBuffer.end(), uint8_t());
+}
+
+bool Socks5UdpSocket::EnterTerminal(int error) {
+    if (_stage == Stage::Closed) {
+        return false;
+    }
+    _stage = Stage::Closed;
+    _proxy.Clear();
+    _relay.Clear();
+    ClearSensitiveState();
+    SetError(error);
+    return true;
+}
+
+void Socks5UdpSocket::Fail(int error, const char *stage) {
+    const auto terminalError = error ? error : SOCKET_EACCES;
+    if (!EnterTerminal(terminalError)) {
+        return;
+    }
+    const auto alive = _alive;
+    const auto terminalFailure = _terminalFailure;
+    DebugFailure(stage, terminalError);
+    if (_tcp) {
+        _tcp->Close();
+    }
+    if (_udp) {
+        _udp->Close();
+    }
+    if (terminalFailure) {
+        terminalFailure(terminalError);
+    }
+    if (!*alive) {
+        return;
+    }
+    NotifyClosed(terminalError);
+}
+
+} // namespace
+
+rtc::AsyncPacketSocket *CreateSocks5UdpSocket(
+        rtc::SocketFactory *socketFactory,
+        const rtc::ProxyInfo &proxy,
+        std::function<void(int)> terminalFailure) {
+    if (!socketFactory
+        || proxy.type != rtc::PROXY_SOCKS5
+        || !IsValidProxyAddress(proxy.address)) {
+        RTC_LOG(LS_ERROR) << "Invalid managed SOCKS5 UDP proxy.";
+        if (terminalFailure) {
+            terminalFailure(SOCKET_EACCES);
+        }
+        return nullptr;
+    }
+    auto credentials = CopyCredentials(proxy);
+    if (!credentials) {
+        RTC_LOG(LS_ERROR) << "Invalid managed SOCKS5 UDP credentials.";
+        if (terminalFailure) {
+            terminalFailure(SOCKET_EACCES);
+        }
+        return nullptr;
+    }
+
+    const auto family = proxy.address.family();
+    const auto local = rtc::SocketAddress(rtc::GetLoopbackIP(family), 0);
+    auto udp = std::unique_ptr<rtc::Socket>(
+        socketFactory->CreateSocket(family, SOCK_DGRAM));
+    if (!udp || udp->Bind(local) < 0) {
+        RTC_LOG(LS_ERROR) << "Managed SOCKS5 UDP bind failed.";
+        if (terminalFailure) {
+            terminalFailure(udp ? udp->GetError() : SOCKET_EACCES);
+        }
+        return nullptr;
+    }
+    auto tcp = std::unique_ptr<rtc::Socket>(
+        socketFactory->CreateSocket(family, SOCK_STREAM));
+    if (!tcp || tcp->Bind(local) < 0) {
+        RTC_LOG(LS_ERROR) << "Managed SOCKS5 control bind failed.";
+        if (terminalFailure) {
+            terminalFailure(tcp ? tcp->GetError() : SOCKET_EACCES);
+        }
+        return nullptr;
+    }
+    if (tcp->SetOption(rtc::Socket::OPT_NODELAY, 1) != 0) {
+        RTC_LOG(LS_WARNING) << "Managed SOCKS5 TCP_NODELAY failed.";
+    }
+
+    auto result = std::make_unique<Socks5UdpSocket>(
+        std::move(tcp),
+        std::move(udp),
+        proxy.address,
+        std::move(credentials),
+        std::move(terminalFailure));
+    if (!result->Start()) {
+        return nullptr;
+    }
+    return result.release();
+}
+
+} // namespace tgcalls
