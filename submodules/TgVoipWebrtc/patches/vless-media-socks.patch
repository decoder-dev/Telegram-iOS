+[[nodiscard]] bool IsInternetFamily(int family) {
+    return family == AF_INET || family == AF_INET6;
+}
+
+[[nodiscard]] bool IsPublicIpv4(const rtc::IPAddress &address) {
+    const auto value = address.ipv4_address();
+    const auto bytes = reinterpret_cast<const uint8_t*>(&value);
+    const auto first = bytes[0];
+    const auto second = bytes[1];
+    const auto third = bytes[2];
+    return first != 0
+        && first != 10
+        && first != 127
+        && first < 224
+        && !(first == 100 && (second & 0xC0) == 0x40)
+        && !(first == 169 && second == 254)
+        && !(first == 172 && (second & 0xF0) == 16)
+        && !(first == 192 && second == 0 && third == 0)
+        && !(first == 192 && second == 0 && third == 2)
+        && !(first == 192 && second == 88 && third == 99)
+        && !(first == 192 && second == 168)
+        && !(first == 198 && (second == 18 || second == 19))
+        && !(first == 198 && second == 51 && third == 100)
+        && !(first == 203 && second == 0 && third == 113);
+}
+
+[[nodiscard]] bool IsPublicIpv6(const rtc::IPAddress &address) {
+    const auto value = address.ipv6_address();
+    const auto bytes = reinterpret_cast<const uint8_t*>(&value);
+    const auto globalUnicast = (bytes[0] & 0xE0) == 0x20;
+    const auto teredo = bytes[0] == 0x20
+        && bytes[1] == 0x01
+        && bytes[2] == 0
+        && bytes[3] == 0;
+    const auto benchmarking = bytes[0] == 0x20
+        && bytes[1] == 0x01
+        && bytes[2] == 0
+        && bytes[3] == 2
+        && bytes[4] == 0
+        && bytes[5] == 0;
+    const auto orchid = bytes[0] == 0x20
+        && bytes[1] == 0x01
+        && bytes[2] == 0
+        && ((bytes[3] & 0xF0) == 0x10
+            || (bytes[3] & 0xF0) == 0x20);
+    const auto documentation = bytes[0] == 0x20
+        && bytes[1] == 0x01
+        && bytes[2] == 0x0D
+        && bytes[3] == 0xB8;
+    const auto sixToFour = bytes[0] == 0x20 && bytes[1] == 0x02;
+    const auto documentationSecond = bytes[0] == 0x3F
+        && bytes[1] == 0xFF
+        && (bytes[2] & 0xF0) == 0;
+    return globalUnicast
+        && !teredo
+        && !benchmarking
+        && !orchid
+        && !documentation
+        && !sixToFour
+        && !documentationSecond;
+}
+
+[[nodiscard]] bool IsValidManagedGroupProxy(const Proxy &proxy) {
+    const auto address = rtc::SocketAddress(proxy.host, proxy.port);
+    return !proxy.host.empty()
+        && proxy.host.find('\0') == std::string::npos
+        && address.port()
+        && !address.IsUnresolvedIP()
+        && IsInternetFamily(address.family())
+        && address.IsLoopbackIP()
+        && (address.family() != AF_INET6 || address.scope_id() == 0)
+        && !proxy.login.empty()
+        && proxy.login.size() <= 255
+        && proxy.login.find('\0') == std::string::npos
+        && !proxy.password.empty()
+        && proxy.password.size() <= 255
+        && proxy.password.find('\0') == std::string::npos;
+}
