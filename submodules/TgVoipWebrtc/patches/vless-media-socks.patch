+
+#ifndef TGCALLS_V2_SOCKS5_PROXY_SOCKET_H_
+#define TGCALLS_V2_SOCKS5_PROXY_SOCKET_H_
+
+#include <cstddef>
+#include <cstdint>
+
+#include "absl/strings/string_view.h"
+#include "rtc_base/buffer.h"
+#include "rtc_base/crypt_string.h"
+#include "rtc_base/socket_adapters.h"
+#include "rtc_base/socket_address.h"
+
+namespace tgcalls {
+
+// A SOCKS5 CONNECT adapter which requires RFC 1929 username/password
+// authentication. The wrapped socket connects only to `proxy`; `destination`
+// is sent inside the SOCKS tunnel.
+class Socks5ProxySocket final : public rtc::BufferedReadAdapter {
+public:
+    Socks5ProxySocket(
+        rtc::Socket *socket,
+        const rtc::SocketAddress &proxy,
+        absl::string_view username,
+        const rtc::CryptString &password);
+    ~Socks5ProxySocket() override;
+
+    Socks5ProxySocket(const Socks5ProxySocket &) = delete;
+    Socks5ProxySocket &operator=(const Socks5ProxySocket &) = delete;
+
+    int Connect(const rtc::SocketAddress &destination) override;
+    rtc::SocketAddress GetRemoteAddress() const override;
+    int Close() override;
+    ConnState GetState() const override;
+
+protected:
+    void OnConnectEvent(rtc::Socket *socket) override;
+    void OnWriteEvent(rtc::Socket *socket) override;
+    void OnCloseEvent(rtc::Socket *socket, int error) override;
+    void ProcessInput(char *data, size_t *length) override;
+
+private:
+    enum class State {
+        Idle,
+        Initial,
+        Greeting,
+        Authentication,
+        Connect,
+        Tunnel,
+        Error,
+    };
+
+    bool sendGreeting();
+    bool sendAuthentication();
+    bool sendConnect();
+    bool queueHandshake(const void *data, size_t length);
+    bool flushHandshake();
+    void clearCredentials();
+    void clearSensitiveState();
+    bool enterTerminal(int error);
+    void fail(int error);
+
+    State _state = State::Idle;
+    rtc::SocketAddress _proxy;
+    rtc::SocketAddress _destination;
+    rtc::ZeroOnFreeBuffer<char> _username;
+    rtc::ZeroOnFreeBuffer<char> _password;
+    rtc::ZeroOnFreeBuffer<char> _pendingOutput;
+    size_t _pendingOffset = 0;
+
+};
+
+} // namespace tgcalls
+
+#endif // TGCALLS_V2_SOCKS5_PROXY_SOCKET_H_
