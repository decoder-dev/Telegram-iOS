+
+[[nodiscard]] bool IsInternetFamily(int family) {
+    return family == AF_INET || family == AF_INET6;
+}
+
+[[nodiscard]] bool IsValidProxyAddress(
+        const rtc::SocketAddress &address) {
+    return address.port()
+        && !address.IsUnresolvedIP()
+        && IsInternetFamily(address.family())
+        && address.IsLoopbackIP()
+        && (address.family() != AF_INET6 || address.scope_id() == 0);
+}
+
+[[nodiscard]] bool IsValidLogicalAddress(
