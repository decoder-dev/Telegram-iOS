+class GroupCryptStringImpl final : public rtc::CryptStringImpl {
+public:
+    explicit GroupCryptStringImpl(const std::string &value)
+    : _value(value) {
+    }
+
+    size_t GetLength() const override {
+        return _value.size();
+    }
+
+    void CopyTo(char *destination, bool nullTerminate) const override {
+        std::memcpy(destination, _value.data(), _value.size());
+        if (nullTerminate) {
+            destination[_value.size()] = 0;
+        }
+    }
+
+    std::string UrlEncode() const override {
+        return _value;
+    }
+
+    CryptStringImpl *Copy() const override {
+        return new GroupCryptStringImpl(_value);
+    }
+
+    void CopyRawTo(std::vector<unsigned char> *destination) const override {
+        destination->resize(_value.size());
+        std::memcpy(destination->data(), _value.data(), _value.size());
+    }
+
+private:
+    std::string _value;
+
+};
