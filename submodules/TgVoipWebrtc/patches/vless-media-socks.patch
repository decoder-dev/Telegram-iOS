diff --git a/tgcalls/v2/Socks5ProxySocket.cpp b/tgcalls/v2/Socks5ProxySocket.cpp
new file mode 100644
index 0000000..9e5c7c2
--- /dev/null
+++ b/tgcalls/v2/Socks5ProxySocket.cpp
@@ -0,0 +1,362 @@
+/*
+ *  Copyright 2004 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#include "v2/Socks5ProxySocket.h"
+
+#include <cstring>
+#include <string>
+
+#include "rtc_base/byte_buffer.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/socket.h"
+
+namespace tgcalls {
+namespace {
+
+constexpr auto kSocksVersion = uint8_t(5);
+constexpr auto kPasswordAuthentication = uint8_t(2);
+constexpr auto kAuthenticationVersion = uint8_t(1);
+constexpr auto kConnectCommand = uint8_t(1);
+constexpr auto kAddressIpv4 = uint8_t(1);
+constexpr auto kAddressDomain = uint8_t(3);
+constexpr auto kAddressIpv6 = uint8_t(4);
+constexpr auto kHandshakeBufferSize = size_t(1024);
+
+[[nodiscard]] bool IsInternetFamily(int family) {
+    return family == AF_INET || family == AF_INET6;
+}
+
+[[nodiscard]] bool IsValidProxyAddress(
+        const rtc::SocketAddress &address) {
+    return address.port()
+        && !address.IsUnresolvedIP()
+        && IsInternetFamily(address.family())
+        && !address.IsAnyIP();
+}
+
+[[nodiscard]] bool IsValidDestination(
+        const rtc::SocketAddress &address) {
+    if (!address.port()) {
+        return false;
+    } else if (address.IsUnresolvedIP()) {
+        const auto hostname = address.hostname();
+        return !hostname.empty()
+            && hostname.size() <= 255
+            && hostname.find('\0') == std::string::npos;
+    }
+    return IsInternetFamily(address.family())
+        && !address.IsAnyIP()
+        && (address.family() != AF_INET6 || address.scope_id() == 0);
+}
+
+} // namespace
+
+Socks5ProxySocket::Socks5ProxySocket(
+    rtc::Socket *socket,
+    const rtc::SocketAddress &proxy,
+    absl::string_view username,
+    const rtc::CryptString &password)
+: rtc::BufferedReadAdapter(socket, kHandshakeBufferSize)
+, _proxy(proxy)
+, _username(username.data(), username.size())
+, _password(password.GetLength()) {
+    password.CopyTo(_password.data(), false);
+}
+
+Socks5ProxySocket::~Socks5ProxySocket() {
+    clearSensitiveState();
+}
+
+int Socks5ProxySocket::Connect(const rtc::SocketAddress &destination) {
+    if (_state != State::Idle
+        || !IsValidProxyAddress(_proxy)
+        || _username.empty()
+        || _username.size() > 255
+        || _password.empty()
+        || _password.size() > 255
+        || !IsValidDestination(destination)) {
+        if (_state == State::Idle) {
+            enterTerminal(SOCKET_EACCES);
+        } else {
+            SetError(SOCKET_EACCES);
+        }
+        return -1;
+    }
+    _destination = destination;
+    _state = State::Initial;
+    BufferInput(true);
+    const auto result = rtc::BufferedReadAdapter::Connect(_proxy);
+    if (result < 0) {
+        enterTerminal(GetError());
+    }
+    return result;
+}
+
+rtc::SocketAddress Socks5ProxySocket::GetRemoteAddress() const {
+    return _destination;
+}
+
+int Socks5ProxySocket::Close() {
+    enterTerminal(0);
+    return rtc::BufferedReadAdapter::Close();
+}
+
+rtc::Socket::ConnState Socks5ProxySocket::GetState() const {
+    if (_state == State::Tunnel) {
+        return rtc::Socket::CS_CONNECTED;
+    } else if (_state == State::Idle || _state == State::Error) {
+        return rtc::Socket::CS_CLOSED;
+    }
+    return rtc::Socket::CS_CONNECTING;
+}
+
+void Socks5ProxySocket::OnConnectEvent(rtc::Socket *) {
+    if (_state != State::Initial) {
+        fail(SOCKET_EACCES);
+        return;
+    }
+    sendGreeting();
+}
+
+void Socks5ProxySocket::OnWriteEvent(rtc::Socket *socket) {
+    if (_state == State::Tunnel) {
+        rtc::BufferedReadAdapter::OnWriteEvent(socket);
+    } else if (_state != State::Error) {
+        flushHandshake();
+    }
+}
+
+void Socks5ProxySocket::OnCloseEvent(rtc::Socket *, int error) {
+    if (!enterTerminal(error)) {
+        return;
+    }
+    SignalCloseEvent(this, error);
+}
+
+void Socks5ProxySocket::ProcessInput(char *data, size_t *length) {
+    RTC_DCHECK(_state != State::Tunnel);
+    RTC_DCHECK(_state != State::Error);
+    if (!_pendingOutput.empty()) {
+        fail(SOCKET_EACCES);
+        return;
+    }
+
+    auto response = rtc::ByteBufferReader(rtc::MakeArrayView(
+        reinterpret_cast<const uint8_t*>(data),
+        *length));
+    if (_state == State::Greeting) {
+        auto version = uint8_t();
+        auto method = uint8_t();
+        if (!response.ReadUInt8(&version) || !response.ReadUInt8(&method)) {
+            return;
+        }
+        if (version != kSocksVersion || method != kPasswordAuthentication) {
+            fail(SOCKET_EACCES);
+            return;
+        }
+        if (!sendAuthentication()) {
+            return;
+        }
+    } else if (_state == State::Authentication) {
+        auto version = uint8_t();
+        auto status = uint8_t();
+        if (!response.ReadUInt8(&version) || !response.ReadUInt8(&status)) {
+            return;
+        }
+        if (version != kAuthenticationVersion || status != 0) {
+            fail(SOCKET_EACCES);
+            return;
+        }
+        if (!sendConnect()) {
+            return;
+        }
+    } else if (_state == State::Connect) {
+        auto version = uint8_t();
+        auto reply = uint8_t();
+        auto reserved = uint8_t();
+        auto addressType = uint8_t();
+        if (!response.ReadUInt8(&version)
+            || !response.ReadUInt8(&reply)
+            || !response.ReadUInt8(&reserved)
+            || !response.ReadUInt8(&addressType)) {
+            return;
+        }
+        if (version != kSocksVersion || reply != 0 || reserved != 0) {
+            fail(SOCKET_EACCES);
+            return;
+        }
+
+        if (addressType == kAddressIpv4) {
+            if (!response.Consume(4 + 2)) {
+                return;
+            }
+        } else if (addressType == kAddressDomain) {
+            auto addressLength = uint8_t();
+            if (!response.ReadUInt8(&addressLength)) {
+                return;
+            }
+            if (!addressLength) {
+                fail(SOCKET_EACCES);
+                return;
+            }
+            if (!response.Consume(size_t(addressLength) + 2)) {
+                return;
+            }
+        } else if (addressType == kAddressIpv6) {
+            if (!response.Consume(16 + 2)) {
+                return;
+            }
+        } else {
+            fail(SOCKET_EACCES);
+            return;
+        }
+        _state = State::Tunnel;
+    } else {
+        fail(SOCKET_EACCES);
+        return;
+    }
+
+    *length = response.Length();
+    if (*length) {
+        std::memmove(data, response.Data(), *length);
+    }
+    if (_state != State::Tunnel) {
+        return;
+    } else if (*length != 0) {
+        // Reflectors do not send application data before the client hello.
+        // Reject ambiguous bytes rather than exposing them across the state
+        // transition or risking a use-after-free after SignalConnectEvent.
+        *length = 0;
+        fail(SOCKET_EACCES);
+        return;
+    }
+    BufferInput(false);
+    SignalConnectEvent(this);
+}
+
+bool Socks5ProxySocket::sendGreeting() {
+    auto request = rtc::ByteBufferWriter();
+    request.WriteUInt8(kSocksVersion);
+    request.WriteUInt8(1);
+    request.WriteUInt8(kPasswordAuthentication);
+    _state = State::Greeting;
+    return queueHandshake(request.Data(), request.Length());
+}
+
+bool Socks5ProxySocket::sendAuthentication() {
+    auto request = rtc::ByteBufferWriterT<rtc::ZeroOnFreeBuffer<char>>();
+    request.WriteUInt8(kAuthenticationVersion);
+    request.WriteUInt8(static_cast<uint8_t>(_username.size()));
+    request.WriteString(absl::string_view(
+        _username.data(),
+        _username.size()));
+    request.WriteUInt8(static_cast<uint8_t>(_password.size()));
+    request.WriteString(absl::string_view(_password.data(), _password.size()));
+    _state = State::Authentication;
+    return queueHandshake(request.Data(), request.Length());
+}
+
+bool Socks5ProxySocket::sendConnect() {
+    auto request = rtc::ByteBufferWriter();
+    request.WriteUInt8(kSocksVersion);
+    request.WriteUInt8(kConnectCommand);
+    request.WriteUInt8(0);
+    if (_destination.IsUnresolvedIP()) {
+        const auto hostname = _destination.hostname();
+        request.WriteUInt8(kAddressDomain);
+        request.WriteUInt8(static_cast<uint8_t>(hostname.size()));
+        request.WriteString(hostname);
+    } else if (_destination.family() == AF_INET) {
+        const auto address = _destination.ipaddr().ipv4_address();
+        request.WriteUInt8(kAddressIpv4);
+        request.WriteBytes(
+            reinterpret_cast<const uint8_t*>(&address),
+            sizeof(address));
+    } else if (_destination.family() == AF_INET6) {
+        const auto address = _destination.ipaddr().ipv6_address();
+        request.WriteUInt8(kAddressIpv6);
+        request.WriteBytes(
+            reinterpret_cast<const uint8_t*>(&address),
+            sizeof(address));
+    } else {
+        fail(SOCKET_EACCES);
+        return false;
+    }
+    request.WriteUInt16(_destination.port());
+    _state = State::Connect;
+    return queueHandshake(request.Data(), request.Length());
+}
+
+bool Socks5ProxySocket::queueHandshake(const void *data, size_t length) {
+    if (!_pendingOutput.empty() || _pendingOffset != 0 || !length) {
+        fail(SOCKET_EACCES);
+        return false;
+    }
+    _pendingOutput = rtc::ZeroOnFreeBuffer<char>(
+        static_cast<const char*>(data),
+        length);
+    return flushHandshake();
+}
+
+bool Socks5ProxySocket::flushHandshake() {
+    while (_pendingOffset < _pendingOutput.size()) {
+        const auto sent = DirectSend(
+            _pendingOutput.data() + _pendingOffset,
+            _pendingOutput.size() - _pendingOffset);
+        if (sent > 0) {
+            _pendingOffset += size_t(sent);
+            continue;
+        } else if (sent < 0 && rtc::IsBlockingError(GetError())) {
+            return true;
+        }
+        fail((sent < 0) ? GetError() : SOCKET_EACCES);
+        return false;
+    }
+    _pendingOutput.Clear();
+    _pendingOffset = 0;
+    if (_state == State::Authentication) {
+        clearCredentials();
+    }
+    return true;
+}
+
+void Socks5ProxySocket::clearCredentials() {
+    _username.Clear();
+    _password.Clear();
+}
+
+void Socks5ProxySocket::clearSensitiveState() {
+    clearCredentials();
+    _pendingOutput.Clear();
+    _pendingOffset = 0;
+}
+
+bool Socks5ProxySocket::enterTerminal(int error) {
+    if (_state == State::Error) {
+        return false;
+    }
+    _state = State::Error;
+    BufferInput(false);
+    _destination.Clear();
+    clearSensitiveState();
+    SetError(error);
+    return true;
+}
+
+void Socks5ProxySocket::fail(int error) {
+    const auto terminalError = error ? error : SOCKET_EACCES;
+    if (!enterTerminal(terminalError)) {
+        return;
+    }
+    rtc::BufferedReadAdapter::Close();
+    SignalCloseEvent(this, terminalError);
+}
+
+} // namespace tgcalls
