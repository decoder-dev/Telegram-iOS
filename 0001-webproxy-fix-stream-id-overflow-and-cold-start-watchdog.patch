+    /// Advances `nextStreamId` within the wire's 24-bit range, skipping 0 (session/control id) and
+    /// any id still live in `streams` after a wrap. A sidecar that only ever goes through soft
+    /// `reconnectTransport` cycles can otherwise mint tens of millions of ids over its lifetime.
+    private func allocateStreamId() -> UInt32 {
+        var candidate = self.nextStreamId
+        var attempts: UInt32 = 0
+        while candidate == 0 || self.streams[candidate] != nil {
+            candidate = candidate == WebProxySidecar.maxStreamId ? 1 : candidate &+ 1
+            attempts &+= 1
+            if attempts > WebProxySidecar.maxStreamId {
+                // Every id is in use — should be unreachable given per-process connection limits,
+                // but fail the stream rather than trap.
+                candidate = 1
+                break
+            }
         }
+        self.nextStreamId = candidate == WebProxySidecar.maxStreamId ? 1 : candidate &+ 1
+        return candidate
+    }
+
+    private func accept(connection: NWConnection) {
